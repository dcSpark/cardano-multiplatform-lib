;$hash28 /= bytes .size 28
;$hash32 /= bytes .size 32

;$vkey /= bytes .size 8

;$vrf_vkey /= bytes .size 8

;$kes_vkey /= bytes .size 8

;$signature /= bytes .size 16

;addr_keyhash          = $hash28
;genesis_delegate_hash = $hash28
;pool_keyhash          = $hash28
;genesishash           = $hash28

;vrf_keyhash           = $hash32
;auxiliary_data_hash   = $hash32
;pool_metadata_hash    = $hash32

; To compute a script hash, note that you must prepend
; a tag to the bytes of the script before hashing.
; The tag is determined by the language.
; The tags in the Babbage era are:
;   "\x00" for multisig scripts
;   "\x01" for Plutus V1 scripts
;   "\x02" for Plutus V2 scripts
;scripthash            = $hash28

;datum_hash = $hash32

KES_signature = bytes .size 448 ; @newtype get

; this isn't referenced anywhere else so we don't provide it.
; signkeyKES = bytes .size 64

VRF_cert = [
  output: bytes,
  proof: bytes .size 80
]

nonce_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy

nonce = [
  ; @name identity
  tag: 0 //
  ; @name hash
  tag: 1, hash: nonce_hash
]

vkeywitness = [ $vkey, ed25519_signature ] ; @used_as_elem

; this is defined in the byron era:
addr_attributes = _CDDL_CODEGEN_EXTERN_TYPE_

bootstrap_witness =
  [ public_key : vkey
  , signature  : ed25519_signature
  , chain_code : bytes .size 32
  , attributes : bytes .cbor addr_attributes
  ] ; @used_as_elem


; all types hand-coded here:
vkey = _CDDL_CODEGEN_RAW_BYTES_TYPE_
VRF_vkey = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
KES_vkey = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
ed25519_signature = _CDDL_CODEGEN_RAW_BYTES_TYPE_
ed25519_key_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @used_as_elem @copy
genesis_delegate_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
genesis_hash           = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
VRF_key_hash           = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
auxiliary_data_hash   = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
pool_metadata_hash    = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
script_hash            = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
datum_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
block_body_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
block_header_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
transaction_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
script_data_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
anchor_doc_hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_ ; @copy
